{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "preserve",
    "types": ["vite/client", "vite-plugin-pwa/client", "vitest/globals", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "server/**/*.ts", "functions/**/*.ts", "scripts/**/*.ts", "vite.config.ts"]
}
